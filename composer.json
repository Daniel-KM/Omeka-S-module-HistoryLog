{
    "name": "daniel-km/omeka-s-module-history-log",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Creates a log of basic curatorial events for each item, collection and file, including ingress, updates, and pushes, and compute statistics on evolution.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "administration",
        "admin trace",
        "curator"
    ],
    "license": "CECILL-2.1",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-HistoryLog",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-HistoryLog/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "_require (not set until Omeka S merges PR #2412)": {
        "omeka/omeka-s": "^4.0",
        "daniel-km/omeka-s-module-common": "*"
    },
    "autoload": {
        "psr-4": {
            "HistoryLog\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HistoryLogTest\\": "tests/HistoryLogTest/"
        }
    },
    "extra": {
        "installer-name": "HistoryLog",
        "configurable": true
    }
}
